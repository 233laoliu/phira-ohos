// You need to change the file name to "build-profile.json5", and configure the signingConfigs in Deveco Studio.
{
  app: {
    signingConfigs: [],
    products: [
      {
        name: 'default',
        signingConfig: 'default',
        // 原文件把 compatible 与 target 写反了（21 > 20），hvigor 会直接拒绝构建。
        targetSdkVersion: '6.0.1(21)',
        compatibleSdkVersion: '6.0.0(20)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          nativeCompiler: 'BiSheng',
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: ['default'],
        },
      ],
    },
  ],
}
